,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["There are some terrorist groups out there you"]},{"code":401,"indent":0,"parameters":["don't want to mess with."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Watch out for Worldshatter.  They sometimes"]},{"code":401,"indent":0,"parameters":["use the letters \"WS\" when they reveal"]},{"code":401,"indent":0,"parameters":["themselves, and in their logos."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["That's it for what I can think of off-the-top-"]},{"code":401,"indent":0,"parameters":["of-my-head."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Stay out of trouble."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":4}
