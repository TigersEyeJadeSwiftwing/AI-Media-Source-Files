{"id":2,"name":"Local Town Guard","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor3","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Dundle Village Guard: Hello children."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["May I help you with something?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\\P[1]: What sort of monsters are on the mainland?"]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Dundle Village Guard: Mostly slimes, orange ones,"]},{"code":401,"indent":0,"parameters":["and then there's a bunch of punks and magic-"]},{"code":401,"indent":0,"parameters":["-using thieves of sorts, plus masterless drones"]},{"code":401,"indent":0,"parameters":["that have built-in guns."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["That's on this side of the mountains.  The"]},{"code":401,"indent":0,"parameters":["slimes over here are weak against fire, and"]},{"code":401,"indent":0,"parameters":["the drones are electronic, so they have the"]},{"code":401,"indent":0,"parameters":["usual resistances against sleep and charm"]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["related attacks, and so on, and can be harmed"]},{"code":401,"indent":0,"parameters":["by Cyber Hack and technological attacks.  The"]},{"code":401,"indent":0,"parameters":["local people hate the drones so much they call"]},{"code":401,"indent":0,"parameters":["them \"stupid drones\" in print."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["That's pretty much it, kids."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Stay out of trouble."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":4}
