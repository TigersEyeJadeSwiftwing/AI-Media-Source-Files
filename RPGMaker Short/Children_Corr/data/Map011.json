{"id":2,"name":"Magic Destiny Book","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["This is more than just a common book.  This is a BIG"]},{"code":401,"indent":0,"parameters":["book with all sorts of facts and how-tos of adventuring,"]},{"code":401,"indent":0,"parameters":["battle, and making one's self into a legend.  It goes far"]},{"code":401,"indent":0,"parameters":["beyond how to fight off monsters and survive in the wild."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["This book will also change the character class of any of"]},{"code":401,"indent":0,"parameters":["your playable characters if they are still level 1."]},{"code":401,"indent":0,"parameters":["With this, you can configure your adventuring party how"]},{"code":401,"indent":0,"parameters":["you want to, all four characters."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Note that of the playable characters, the one named"]},{"code":401,"indent":0,"parameters":["\\N[11] is better at everything than the others"]},{"code":401,"indent":0,"parameters":["and his/her three friends.  No matter what his/her class"]},{"code":401,"indent":0,"parameters":["he/she can use any spellbook and equip any weapon."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Also note that in both this game and real life, a \"witch\" is"]},{"code":401,"indent":0,"parameters":["not always female, and the term is applicable to both male"]},{"code":401,"indent":0,"parameters":["and female people, much like in Wicca, founded by Gerald"]},{"code":401,"indent":0,"parameters":["Gardner, and the American version, Seax-Wica, founded by"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Raymond Buckland who brought the tradition to the USA from"]},{"code":401,"indent":0,"parameters":["England.  (These are and were real people in real life, BTW,"]},{"code":401,"indent":0,"parameters":["although Raymond Buckland passed away in 2017 after living"]},{"code":401,"indent":0,"parameters":["in Ohio, who has videos on Youtube on real-life witchcraft.)"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Skipping past a bunch of history and stuff, a \"witch\" in"]},{"code":401,"indent":0,"parameters":["this game is a replacement for a \"priest\" class and does"]},{"code":401,"indent":0,"parameters":["healing as well as other types of magic, and is NOT a"]},{"code":401,"indent":0,"parameters":["practitioner of Seax-Wica or any Wicca, but can be either"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["gender.  A \"warlock\", by definition FYI, is not always a"]},{"code":401,"indent":0,"parameters":["proper term for a male gender witch.  In some cases, with"]},{"code":401,"indent":0,"parameters":["certain traditions, it refers to a witch who broke an oath,"]},{"code":401,"indent":0,"parameters":["and shouldn't be used."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The \"warrior\" class gets to act twice in combat, can use"]},{"code":401,"indent":0,"parameters":["most weapons, and gets special attacks with accumulated \"SP\""]},{"code":401,"indent":0,"parameters":["or \"Special Points\" that build up when hit and when attacking"]},{"code":401,"indent":0,"parameters":["in combat.  Special moves with weapons come with leveling up."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The \"wizard\" class can't use most weapons as they require"]},{"code":401,"indent":0,"parameters":["practice and discipline that a wizard doesn't have time for."]},{"code":401,"indent":0,"parameters":["They can use some firearms quite effectively, and if they"]},{"code":401,"indent":0,"parameters":["equip a staff it will increase the magic of their spells."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The \"soldier\" class can't use swords and many melee weapons,"]},{"code":401,"indent":0,"parameters":["but can equip whips, daggers, and clubs, and any firearm as"]},{"code":401,"indent":0,"parameters":["well as rockets and explosives.  They can equip two weapons"]},{"code":401,"indent":0,"parameters":["at a time but only use one at a time in combat, where"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["they only get one action per turn but for each action they"]},{"code":401,"indent":0,"parameters":["choose from attacks of both weapons which are equipped.  All"]},{"code":401,"indent":0,"parameters":["other classes can only equip one weapon at a time, plus any"]},{"code":401,"indent":0,"parameters":["magic from spellbooks and rings.  A soldier character"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["has a default standard attack based upon whatever is"]},{"code":401,"indent":0,"parameters":["equipped in the SECOND weapon slot, unless only one weapon"]},{"code":401,"indent":0,"parameters":["is equipped.  Equipping them with two guns of the same type"]},{"code":401,"indent":0,"parameters":["doesn't do much for them and can be a waste."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Just keep in mind that you need to buy spellbooks for"]},{"code":401,"indent":0,"parameters":["witches and wizards for them to do magic of any sort.  Once"]},{"code":401,"indent":0,"parameters":["they equip a spellbook they have magics that work in and out"]},{"code":401,"indent":0,"parameters":["of combat.  Class determines what color books they equip."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["(If you are stuck reading through ANY text, like this, that"]},{"code":401,"indent":0,"parameters":["is long-winded, the \"A\" button on a game controller will"]},{"code":401,"indent":0,"parameters":["help speed through it.  This also works in combat.)"]},{"code":119,"indent":0,"parameters":["main menu"]},{"code":118,"indent":0,"parameters":["loop start"]},{"code":101,"indent":0,"parameters":["",0,0,0,""]},{"code":401,"indent":0,"parameters":["Change the class of which party member?"]},{"code":102,"indent":0,"parameters":[["None / Finished","\\N[11]","\\N[12]","\\N[13]","\\N[14]"],0,0,2,0]},{"code":402,"indent":0,"parameters":[0,"None / Finished"]},{"code":119,"indent":1,"parameters":["main menu"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"\\N[11]"]},{"code":122,"indent":1,"parameters":[1,1,0,3,3,11,0]},{"code":111,"indent":1,"parameters":[1,1,0,1,3]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["\\N[11] cannot change class.  He/She has already progressed"]},{"code":401,"indent":2,"parameters":["in level and experience, it is too late for him/her."]},{"code":119,"indent":2,"parameters":["loop start"]},{"code":0,"indent":2,"parameters":[]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["What should \\N[11]'s class now be?"]},{"code":102,"indent":2,"parameters":[["Warrior","Wizard","Witch","Soldier","Cancel"],4,4,2,0]},{"code":402,"indent":2,"parameters":[0,"Warrior"]},{"code":321,"indent":3,"parameters":[11,1,true]},{"code":119,"indent":3,"parameters":["loop start"]},{"code":0,"indent":3,"parameters":[]},{"code":402,"indent":2,"parameters":[1,"Wizard"]},{"code":321,"indent