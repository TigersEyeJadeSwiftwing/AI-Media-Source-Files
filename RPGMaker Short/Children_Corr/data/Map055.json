1,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["So exactly WHAT is it I'm picking up on about you CLOWNS at"]},{"code":401,"indent":0,"parameters":["your location having an UNAUTHORIZED POTTED PLANT IN THE"]},{"code":401,"indent":0,"parameters":["CORNER OF YOUR OFFICE?????"]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Town Guard: Uh, I'll have it removed,"]},{"code":401,"indent":0,"parameters":["sir!"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["(The angry voice snarls back.)"]},{"code":401,"indent":0,"parameters":["DO THAT."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["(The call ends.)"]},{"code":250,"indent":0,"parameters":[{"name":"Cursor3","volume":100,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Town Guard: Sorry children, I'll be"]},{"code":401,"indent":0,"parameters":["busy for a bit."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Stay out of trouble."]},{"code":121,"indent":0,"parameters":[68,68,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":58,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor3","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Town Guard: Hi kids.  I can't help you with"]},{"code":401,"indent":0,"parameters":["what the king wants you to do, or end up"]},{"code":401,"indent":0,"parameters":["getting in the way."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["You don't need any special permission to go to"]},{"code":401,"indent":0,"parameters":["the grade D levels, and here on level C you are"]},{"code":401,"indent":0,"parameters":["welcome to use the shops and Inn, etc., as much"]},{"code":401,"indent":0,"parameters":["as you'd like."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Happy Hunting."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Stay out of trouble."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":58,"switch1Valid":true,"switch2Id":59,"switch2Valid":true,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor3","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Town Guard: Hey, glad you got rid of that guy!"]},{"code":401,"indent":0,"parameters":["His henchmen are still roaming around down"]},{"code":401,"indent":0,"parameters":["there, but we'll handle it from here.  You've"]},{"code":401,"indent":0,"parameters":["done us a great service."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["I don't have anything special for you, sorry."]},{"code":401,"indent":0,"parameters":["You deserve medals though.  Oh well."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Bye, stay out of trouble."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":67,"switch1Valid":true,"switch2Id":59,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor3","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Town Guard: I heard you're here on the King's"]},{"code":401,"indent":0,"parameters":["authority.  If you want to go to level B areas,"]},{"code":401,"indent":0,"parameters":["you can now do so."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["If you need to request help from us, talk to"]},{"code":401,"indent":0,"parameters":["us at the B Level office, which is in the same"]},{"code":401,"indent":0,"parameters":["area as where you first enter the B levels."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["You can also ask any officer who lets you into"]},{"code":401,"indent":0,"parameters":["the B levels any questions you'd like.  I would"]},{"code":401,"indent":0,"parameters":["do that here, but unfortunately I'm really"]},{"code":401,"indent":0,"parameters":["busy, so I'll send along your paperwork."]},{"code":101,"indent":0,"parameters":["Actor3",6,0,2,""]},{"code":401,"indent":0,"parameters":["Just show any officer who admits you to the B"]},{"code":401,"indent":0,"parameters":["levels your regular Corr Kingdom citizenship"]},{"code":401,"indent":0,"parameters":["ID or any other government photo ID."]},{"code":101,"indent"