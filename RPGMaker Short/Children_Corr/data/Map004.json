{"id":2,"name":"Diner service","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":5,"characterName":"People1","direction":2,"pattern":1,"tileId":0},"list":[{"code":117,"indent":0,"parameters":[8]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":3,"y":6},
{"id":3,"name":"citizen","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People1","direction":4,"pattern":1,"characterIndex":2},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Citizen: So you grew up in this village?  So did I, and I"]},{"code":401,"indent":0,"parameters":["think it sucks.  I know the tourists love it, but I'm tired"]},{"code":401,"indent":0,"parameters":["of it.  I think I'll move out some day.  I'm waiting for"]},{"code":401,"indent":0,"parameters":["the prices at the ticket office in Fesh to go down."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["They used to have good prices for trips to a lot of places,"]},{"code":401,"indent":0,"parameters":["and free trips right across to Dundle with special offers."]},{"code":401,"indent":0,"parameters":["Then they started complaining about bandits and kobolds,"]},{"code":401,"indent":0,"parameters":["and all the prices went up."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Here in Zeck, kobolds kidnap children right outside the"]},{"code":401,"indent":0,"parameters":["village, who usually don't come back.  The tourists keep"]},{"code":401,"indent":0,"parameters":["pouring in though, and they want to take vacations here so"]},{"code":401,"indent":0,"parameters":["bad they don't care about the risk.  We still make money."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["So many tourists from all over more than one kingdom want"]},{"code":401,"indent":0,"parameters":["to take vacations on this island so bad they demanded that"]},{"code":401,"indent":0,"parameters":["King Corr order the island to still be open for business."]},{"code":401,"indent":0,"parameters":["Corr was overwhelmed and really had to give in."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Like I said, we still make money here, so in a way it isn't"]},{"code":401,"indent":0,"parameters":["like we're complaining with all the business.  I feel bad"]},{"code":401,"indent":0,"parameters":["for the kids that disappear, but hey, I make a good living"]},{"code":401,"indent":0,"parameters":["entertaining tourists, one party after another for them."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You children look tough.  Some kids survive kobold and"]},{"code":401,"indent":0,"parameters":["bandit attacks and escape them.  Good luck to you!"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":9,"y":6},
{"id":4,"name":"citizen","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor2","direction":4,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Citizen: Characters who are warrior class normally act"]},{"code":401,"indent":0,"parameters":["twice in combat.  So if you're in a fight and you find you're"]},{"code":401,"indent":0,"parameters":["prompted for what to do twice, this isn't a bug - It means"]},{"code":401,"indent":0,"parameters":["you're picking two things to do for your turn instead of one."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":13,"y":6},
{"id":5,"name":"citizen","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor2","direction":4,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Citizen: While machine guns and pistols are fun in combat,"]},{"code":401,"indent":0,"parameters":["they're mostly helpful when your characters are low-level."]},{"code":401,"indent":0,"parameters":["As they level up and have their abilities increase, they'll"]},{"code":401,"indent":0,"parameters":["outgrow such weapons."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["At least that's true until better firearms are available."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Don't be surprised if you change weapon and equipment"]},{"code":401,"indent":0,"parameters":["strategies as your characters level up in your adventures."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Also, some weapons have higher attack score bonuses but are"]},{"code":401,"indent":0,"parameters":["not as good as other weapons.  Clubs and daggers are simple"]},{"code":401,"indent":0,"parameters":["and not as good at melee, along with staves, and axes are"]},{"code":401,"indent":0,"parameters":["almost as good as swords which are the best."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Bows and crossbows only use half your attack score instead"]},{"code":401,"indent":0,"parameters":["of the whole thing, as they use an average of your attack"]},{"code":401,"indent":0,"parameters":["and agility scores."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":9,"y":8},
{"id":6,"name":"citizen","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"People1","direction":6,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Kid: I don't know much that I think would help you guys."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["I heard talk of a weapons dealer that lives in the slums of"]},{"code":401,"indent":0,"parameters":["Yaster Supercity Grade D Levels."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["I heard he sells to visitors to the city and defends his"]},{"code":401,"indent":0,"parameters":["store against all the gangs, and no one can take him over."]},{"code":401,"indent":0,"parameters":["He sells all sorts of guns and cool stuff that goes boom,"]},{"code":401,"indent":0,"parameters":["and things that no one else has anywhere."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Its in that high-tech city on the mainland, near Castle Corr."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["He doesn't sell as much to people who haven't done a lot of"]},{"code":401,"indent":0,"parameters":["battle though."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":11,"y":8}
