{"id":3,"name":"Citizen","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"AsianMale1","direction":6,"pattern":1,"characterIndex":7},"list":[{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"The Red Hawk folk and the Golden Fox people of this world are locked in eternal warfare and conflict.  Each raise their children to fight the other side, just as"]},{"code":401,"indent":0,"parameters":["each had their own parents and schoolteachers teach them.  Neither side can tolerate the ways of the other when it comes to which side a roll of fresh toilet"]},{"code":401,"indent":0,"parameters":["paper should roll when placed in a dispenser.  One side favors it rolling away from the wall, while the other would die rather than it not roll towards the wall."]},{"code":401,"indent":0,"parameters":["It goes to show how wars can start for the silliest reasons.\""]},{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"Kinda funny how both sides are blinded by their hatred for the ways of the other that neither side is willing to see any greater picture, or"]},{"code":401,"indent":0,"parameters":["try to figure out what caused their own conflict to begin in the first place.\""]},{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"Well, I'm finished with my meal now.  You gentlepersons can have a nice day now, take care.\""]},{"code":123,"indent":0,"parameters":["A",0]},{"code":121,"indent":0,"parameters":[28,28,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"