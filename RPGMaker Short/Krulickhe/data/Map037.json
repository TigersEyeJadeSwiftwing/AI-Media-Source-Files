{"id":3,"name":"Kaito's mother","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"AsianFemale1","direction":6,"pattern":1,"characterIndex":4},"list":[{"code":101,"indent":0,"parameters":["AsianFemale1",4,1,2,"Kaito's mother"]},{"code":401,"indent":0,"parameters":["\"Kaito!\""]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["\"Mom!!!\""]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["Tears in his eyes, Kaito runs to his mother's arms."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["He hugs her tightly."]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["You stand quietly, giving the two a moment.  But then, a voice speaks, cold and sinister, with a deadly and serious tone that makes"]},{"code":401,"indent":0,"parameters":["you almost jump in shock, and surprises you once you suddenly realize who is speaking."]},{"code":101,"indent":0,"parameters":["AsianMale1",6,1,2,"Niko"]},{"code":401,"indent":0,"parameters":["\"About the arrangement miss, you said you would pay us twenty thousand to have us bring your boy back.  I'd appreciate it if we would"]},{"code":401,"indent":0,"parameters":["get that settled now.  I hope you have the money with you.\""]},{"code":101,"indent":0,"parameters":["AsianFemale1",4,1,2,"Kaito's mother"]},{"code":401,"indent":0,"parameters":["\"Oh, I will get it for you soon!  Thank you so much for bringing my son back to me alive and well, it means so much to me!\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"I will throw a celebration at my home tonight for dinner!  Would you come?\""]},{"code":101,"indent":0,"parameters":["AsianMale1",6,1,2,"Niko"]},{"code":401,"indent":0,"parameters":["What Niko does next, in response to Kaito's mother, makes your heart skip a beat in shock!"]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["Kaito freezes in place, holding his breath, with his eyes bulging in flight-or-fight fear and surprise as Niko grabs Kaito by"]},{"code":401,"indent":0,"parameters":["the arm, yanking him over to his side, then draws a sharp dagger out of his pocket and holds the blade of it up to young"]},{"code":401,"indent":0,"parameters":["Kaito's neck!"]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["Poor Kaito looks like he wants to scream in terror but can't breathe."]},{"code":101,"indent":0,"parameters":["AsianMale1",6,1,2,"Niko"]},{"code":401,"indent":0,"parameters":["Angry, Niko snarls:  \"We had a DEAL, miss!\""]},{"code":101,"indent":0,"parameters":["GoldenFox1",0,1,2,"Kenji"]},{"code":401,"indent":0,"parameters":["\"Niko!  NO!!!\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Shit Niko!  Seriously, what the fuck!?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["AsianFemale1",4,1,2,"Kaito's mother"]},{"code":401,"indent":0,"parameters":["\"Niko!  Oh!  I had no idea you meant to do this!  I will pay you!  I will give you your money!  But please!  My son!  Please don't hurt him!\""]},{"code":101,"indent":0,"parameters":["AsianFemale1",4,1,2,"Kaito's mother"]},{"code":401,"indent":0,"parameters":["\"Here, this is all I have at the moment!  I promise I will get you the rest later!\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Kaito's mother pulls a wallet out of her pocket and takes all the cash out of it, handing it to Niko."]},{"code":101,"indent":0,"parameters":["AsianMale1",6,1,2,"Niko"]},{"code":401,"indent":0,"parameters":["Angrier than ever, Niko speaks, hissing like a snake:  \"This is only half of it, miss!\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Maybe you should have only half of your kid!\""]},{"code":101,"indent":0,"parameters":["AsianMale1",6,1,2,"Niko"]},{"code":401,"indent":0,"parameters":["Niko pushes the dagger's blade slightly against Kaito's neck, making it bleed!"]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["Kaito looks even more terrified and traumatized then ever.  He wimpers softly, tears running down his face."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Yourself, you feel a mix of super-intense emotions of fear, concern, worry, and caring for Kaito, combined with anger and massive hatred for Niko."]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[36]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["You draw your sword."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Niko, you sick fuck!  You are so fucking DEAD you motherfucking-\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["GoldenFox1",0,1,2,"Kenji"]},{"code":401,"indent":0,"parameters":["\"NO!!!  No bloodshed!!!  This is WRONG!!!\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Niko, I will pay you the rest of what Kaito's mother owes you.  Please put your dagger away and stop scaring us all!  I will pay you right now!\""]},{"code":101,"indent":0,"parameters":["GoldenFox1",0,1,2,"Kenji"]},{"code":401,"indent":0,"parameters":["Kenji pulls out his own wallet and hands Niko a wad of cash."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"There!  More than enough.  You may go in peace!\""]},{"code":205,"indent":0,"parameters":[4,{"list":[{"code":37,"indent":0},{"code":19,"indent":null},{"code":4,"indent":null},{"code":41,"parameters":["",0],"indent":null},{"code":4,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":37,"indent":0}]},{"code":505,"indent":0,"parameters":[{"code":19,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":41,"parameters":["",0],"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":101,"indent":0,"parameters":["AsianFemale1",4,1,2,"Kaito's mother"]},{"code":401,"indent":0,"parameters":["\"Oh my...  Well thank you so much...\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Kenji, I promise I will pay you back what you gave Niko, and I should have enough to pay the rest of you as well.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"That won't be necessary, ma'am.  You and your son have been through enough.  I'm just glad you got Kaito back.  You don't owe me or my friends anything.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["Kaito hugs his mother tightly, tears still flowing, but relief on his face, his eyes closed.  He doesn't seem to be aware that his"]},{"code":401,"indent":0,"parameters":["neck is still bleeding slightly, from Niko's dagger."]},{"code":101,"indent":0,"parameters":["AsianFemale1",4,1,2,"Kaito's mother"]},{"code":401,"indent":0,"parameters":["\"Oh thank you, you're a very nice young man.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"You're welcome.  Um, your son's neck is bleeding a little bit from what Niko did to it...\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["GoldenFox1",0,1,2,"Kenji"]},{"code":401,"indent":0,"parameters":["\"I will talk to other town authorities and have Niko dealt with!  \\P[1], do NOT go chasing after him!  I will see to it he is"]},{"code":401,"indent":0,"parameters":["dealt with the proper way.  Understand?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["You pause for a moment, and look away, still angry at Niko."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Understood, Kenji.  I get it.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":122,"indent":0,"parameters":[34,34,0,0,100]},{"code":101,"indent":0,"parameters":["GoldenFox1",0,1,2,"Kenji"]},{"code":401,"indent":0,"parameters":["\"All right then, let's leave this sewer!\""]},{"code":101,"indent":0,"parameters":["m child 3 asian kaito",3,1,2,"Kaito"]},{"code":401,"indent":0,"parameters":["Kaito has left your party."]},{"code":129,"indent":0,"parameters":[13,1,false]},{"code":201,"indent":0,"parameters":[0,19,39,16,2,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequenc