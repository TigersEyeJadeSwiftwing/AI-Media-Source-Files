s":["",0,1,2,""]},{"code":401,"indent":2,"parameters":["What!?  You just broke the farmer's son out, and now you want to take him right back inside?  Seriously, what are you thinking?"]},{"code":119,"indent":2,"parameters":["end"]},{"code":0,"indent":2,"parameters":[]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["",0,1,2,""]},{"code":401,"indent":2,"parameters":["You're not going back inside this castle again, so if you think you missed something, it's too late, at least for this playthrough."]},{"code":119,"indent":2,"parameters":["end"]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":118,"indent":0,"parameters":["end"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":8,"y":3},
{"id":2,"name":"exit","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":201,"indent":0,"parameters":[0,1,86,37,2,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":false}],"x":8,"y":21},
{"id":3,"name":"autorun","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":37,"variableValid":true,"variableValue":30},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Well, I don't think we do this by just knocking politely.  The Duke has already bullied the farmer, and went as far as kidnapping the farmer's"]},{"code":401,"indent":0,"parameters":["son by force, so that shows the Duke isn't going to be civil about this, not after doing that.  I say we storm the castle, and fight our way in"]},{"code":401,"indent":0,"parameters":["quick and fast, and try to save the farmer's son as soon as possible.  We should use the element of surprise until it wears out its"]},{"code":401,"indent":0,"parameters":["welcome.\""]},{"code":117,"indent":0,"parameters":[28]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[3]"]},{"code":401,"indent":0,"parameters":["\"I take it you don't want to put on your wings and fly over top for anything.\""]},{"code":117,"indent":0,"parameters":[23]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Nah, there's no point.  I'd be separated from you guys, and we'd lose any element of surprise, and they could try to shoot me down with whatever."]},{"code":401,"indent":0,"parameters":["I think its a bad idea, and would work against us, and wouldn't do anything for us.  I don't think they'd keep a kidnapped kid outside on the roof"]},{"code":401,"indent":0,"parameters":["for me to spot either, and I don't have x-ray vision, so looking at the roof from above wouldn't help us find him.\""]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"We need to make sure we're ready for a lot of fighting, that we're well stocked up on supplies and weapons, and be prepared to go in"]},{"code":401,"indent":0,"parameters":["and not come back out until we find the farmer's son.  We can't fight our way through half the castle and then come back later for the"]},{"code":401,"indent":0,"parameters":["other half after going back to town, as they might kill the farmer's kid, or go after the farmer, or who knows what.  Any way you slice"]},{"code":401,"indent":0,"parameters":["it, they wouldn't just sit waiting for us to storm the other half of the castle.\""]},{"code":117,"indent":0,"parameters":[26]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[2]"]},{"code":401,"indent":0,"parameters":["\"Agreed.  We take this castle on all at once.  No breaks partway to run back to town to rest, or buy stuff.  We're with you,"]},{"code":401,"indent":0,"parameters":["\\P[1].  If we need more supplies, we go back NOW and THEN come back to storm the castle, BEFORE stepping inside.\""]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"We might want to get a few extra weapons and things to equip the farmer's son with, in case he has no possessions and needs to defend"]},{"code":401,"indent":0,"parameters":["himself.  If he had any equipment when he was taken, we might not have time to look for it.\""]},{"code":117,"indent":0,"parameters":[25]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[2]"]},{"code":401,"indent":0,"parameters":["\"We're not going after the Duke too, are we?\""]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"No.  'Course not.  He seems like a bad guy, to have kidnapped the farmer's kid, but two wrongs don't make a right, and the farmer didn't"]},{"code":401,"indent":0,"parameters":["ask us to fight him, just to get his son back.  We go in, we rescue the kid, and get back to the farm.  We're not here for the Duke, not"]},{"code":401,"indent":0,"parameters":["unless he gets in the way of us getting that kid back and forces us to face him.\""]},{"code":117,"indent":0,"parameters":[23]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"All right, we'll head inside when we're ready.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":false},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":37,"variableValid":true,"variableValue":30},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":8,"y":0}
