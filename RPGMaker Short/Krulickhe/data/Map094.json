{"id":6,"name":"farmer","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"m adult 1b cauc orange","direction":4,"pattern":1,"characterIndex":5},"list":[{"code":111,"indent":0,"parameters":[1,37,0,0,0]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Hi, I'm busy, and I don't have much to offer you.  No handouts!"]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["If you're looking for civilization, there's a town in the mountains to the west of here.\""]},{"code":119,"indent":1,"parameters":["end"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":111,"indent":0,"parameters":[1,37,0,10,0]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Hi, I'm busy, and I don't have much to offer you.  No handouts!"]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["If you're looking for civilization, there's a town in the mountains to the west of here.\""]},{"code":119,"indent":1,"parameters":["end"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":111,"indent":0,"parameters":[1,37,0,20,0]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Hi, I'm busy, and I don't have much to offer you.  No handouts!"]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["If you're looking for civilization, there's a town in the mountains to the west of here.\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":1,"parameters":[23]},{"code":101,"indent":1,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":1,"parameters":["\"Excuse me sir, do you happen to have a boat we could use?  We're on a quest to stop the supervolacno from erupting, and we were told"]},{"code":401,"indent":1,"parameters":["to get to a different island.\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Let me guess - The Wise Guy Who Knows Stuff told you, right?\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":1,"parameters":[22]},{"code":101,"indent":1,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":1,"parameters":["\"Yup.  He's the one who told us.\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Yeah, I've got a boat, but I don't let just anybody use it.  Listen, there's a guy who owns and runs a castle a little south and to the east of"]},{"code":401,"indent":1,"parameters":["my farm, who self-appointed himself as \"Duke,\" who wanted to buy my farm, then only let me live on it if I pay him taxes for using what's really"]},{"code":401,"indent":1,"parameters":["my farm to begin with.  I told him to go shove it, and he kidnapped my son.  I think my boy is still in his castle.  If you can get him back,"]},{"code":401,"indent":1,"parameters":["I'll let you use my boat for your quest.  I really want my son back, and he means a lot to me.  Fair enough?\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":1,"parameters":[22]},{"code":101,"indent":1,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":1,"parameters":["\"Fair enough.  We'll talk to this Duke guy, and see what we can do.\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Thanks.  I'd really appreciate it if you rescue him.  He's only 13.\""]},{"code":122,"indent":1,"parameters":[37,37,0,0,30]},{"code":119,"indent":1,"parameters":["end"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":111,"indent":0,"parameters":[1,37,0,30,0]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Like I said, just bring my son back to me, and my boat is yours.  The Duke's castle is south of the harbor, and east of here.\""]},{"code":119,"indent":1,"parameters":["end"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":111,"indent":0,"parameters":[1,37,0,40,0]},{"code":111,"indent":1,"parameters":[4,15,0]},{"code":101,"indent":2,"parameters":["m child 1 cauc orange",1,1,2,"Jim"]},{"code":401,"indent":2,"parameters":["Jim's face lights up brightly when he sees his father."]},{"code":401,"indent":2,"parameters":[""]},{"code":401,"indent":2,"parameters":["\"Dad!!!\""]},{"code":101,"indent":2,"parameters":["m child 1 cauc orange",1,1,2,"Jim"]},{"code":401,"indent":2,"parameters":["Jim runs to his father, who holds his arms out for him."]},{"code":401,"indent":2,"parameters":[""]},{"code":401,"indent":2,"parameters":["The two hug each other tightly.  Tears stream down Jim's face, but this time they are tears of joy and relief."]},{"code":101,"indent":2,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":2,"parameters":["\"Oh Jim...  I thought I'd never see you again, kiddo!\""]},{"code":101,"indent":2,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":2,"parameters":["You and your friends respectfully wait a few moments for the farmer and his son."]},{"code":401,"indent":2,"parameters":[""]},{"code":401,"indent":2,"parameters":["The farmer eventually lets Jim out of his arms."]},{"code":401,"indent":2,"parameters":["\"Okay now, give these kind people who rescued you their things back that you borrowed, and go inside, son...\""]},{"code":250,"indent":2,"parameters":[{"name":"Equip1","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":2,"parameters":["m child 1 cauc orange",1,1,2,"Jim"]},{"code":401,"indent":2,"parameters":["Jim checks his things, and returns any weapons he borrowed back to your party."]},{"code":319,"indent":2,"parameters":[15,1,0]},{"code":319,"indent":2,"parameters":[15,1,0]},{"code":101,"indent":2,"parameters":["m child 1 cauc orange",1,1,2,"Jim"]},{"code":401,"indent":2,"parameters":["Jim leaves your party."]},{"code":129,"indent":2,"parameters":[15,1,false]},{"code":101,"indent":2,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":2,"parameters":["As his son runs into the house, excited to be home, the farmer turns to you."]},{"code":101,"indent":2,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":2,"parameters":["\"Well thank you.  I can't say that enough.  You can have my boat, its just east of my farm.  Its yours to keep now, if you want."]},{"code":401,"indent":2,"parameters":["I want to give you more, as my son means everything to me, but I don't really have much else to give you.  Again, thank you."]},{"code":401,"indent":2,"parameters":[""]},{"code":401,"indent":2,"parameters":["Take care!\""]},{"code":202,"indent":2,"parameters":[0,0,1,48,24]},{"code":0,"indent":2,"parameters":[]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":2,"parameters":["\"Thanks again.  My boy means everything to me.  The boat is yours, so take good care of it.  It's just east and south of my farm."]},{"code":401,"indent":2,"parameters":["I wish I had more to give you."]},{"code":401,"indent":2,"parameters":[""]},{"code":401,"indent":2,"parameters":["Take care!\""]},{"code":202,"indent":2,"parameters":[0,0,1,48,24]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":119,"indent":1,"parameters":["end"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":111,"indent":0,"parameters":[1,37,0,41,1]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Well hello again, young man.  My boy Jim is doing better.  He's healing - slowly, but he's healing.  His body is bouncing back"]},{"code":401,"indent":1,"parameters":["pretty quick though - he's been able to do his chores and play his games again without problems.  He also still practices"]},{"code":401,"indent":1,"parameters":["swordfighting.  As for the Duke, I'll worry about that man and his henchmen.  I've got some allies from the town in the mountains"]},{"code":401,"indent":1,"parameters":["now who will back me up against him, so don't worry about that.\""]},{"code":101,"indent":1,"parameters":["m adult 1b cauc orange",5,1,2,"Farmer"]},{"code":401,"indent":1,"parameters":["\"Thanks again.  My boy means everything to me.  The boat is yours, so take good care of it.  It's just east and south of my farm."]},{"code":401,"indent":1,"parameters":["I wish I had more to give you."]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["Take care!\""]},{"code":202,"indent":1,"parameters":[0,0,1,48,24]},{"code":119,"indent":1,"parameters":["end"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":118,"indent":0,"parameters":["end"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through