{"id":3,"name":"The Big Bad Guy","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"m adult 1b cauc black","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["m adult 1b cauc black",0,1,2,"Man"]},{"code":401,"indent":0,"parameters":["You see a man holding an open book.  As you approach, he glances back and forth at one of the pages and you and your friends."]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Hi sir, do you know anything about The Big Bad Guy or where to find him?  Or maybe a special toilet paper dispenser we heard about?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["m adult 1b cauc black",0,1,2,"Man"]},{"code":401,"indent":0,"parameters":["The man smiles."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Ah, I knew you would ask me that.  It says so right here on this page, your exact words, right before mine!"]},{"code":401,"indent":0,"parameters":["Now watch this...\""]},{"code":101,"indent":0,"parameters":["m adult 1b cauc black",0,1,2,"Man"]},{"code":401,"indent":0,"parameters":["The man produces a simple-looking ball-point pen and writes something in the book."]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[31]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[4]"]},{"code":401,"indent":0,"parameters":["\"Ow!  Hey!  What the-\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\\P[4] clutches his head suddenly with one hand."]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["m adult 1b cauc black",0,1,2,"Man"]},{"code":401,"indent":0,"parameters":["\"You've felt better, haven't you?  Allow me to read out loud what I wrote."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["'\\P[4] suddenly has a slight headache for no apparent reason.'\""]},{"code":101,"indent":0,"parameters":["m adult 1b cauc black",0,1,2,"Man"]},{"code":401,"indent":0,"parameters":["Grinning, the man turns the pages toward you and points to what he wrote."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"See?  Brilliant for a magical book of destiny, don't you think?\""]},{"code":101,"indent":0,"parameters":["m adult 1b cauc black",0,1,2,"The Big Bad Guy"]},{"code":401,"indent":0,"parameters":["The man holds his pen ready to write some more."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"If you think you'll defeat me, you're going to have to-\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[37]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"My pleasure, asshole!\""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Not prepared for a surprise attack, The Big Bad Guy fumbles his pen, which falls to the floor, but he draws a sword and a spellbook"]},{"code":401,"indent":0,"parameters":["to defend himself!"]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":132,"indent":0,"parameters":[{"name":"- 20 - Boss 1","volume":90,"pitch":100,"pan":0}]},{"code":301,"indent":0,"parameters":[0,94,false,false]},{"code":132,"indent":0,"parameters":[{"na