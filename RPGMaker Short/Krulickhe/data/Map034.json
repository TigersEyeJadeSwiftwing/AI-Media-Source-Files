{"id":4,"name":"Citizen","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"girls 1","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"Hi mister.  Are you a dragon?  Your skin is white like photo paper.  Is that dragon skin?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Half dragon.  Yeah its dragon white skin.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"So can you breathe fire?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Yeah.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"And you're immune to fire, right?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Yeah.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"And ice and cold weather won't hurt you?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Nope.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"So when the weather changes, do you change how you dress?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Uh, not always, Its not like I have to, unlike a human, but sometimes I change when my parents get uptight and turn it into a federal case when I leave the house.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"What do you mean by federal case?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Um, just forget I said that.  Long story.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"Why don't you have any armpit hair?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Half dragon.  I don't have any body hair, anywhere on my body.  Just my scalp, eyebrows, and eyelashes.  I also don't shave - there's no point,"]},{"code":401,"indent":0,"parameters":["'cuz I can't grow a beard even if I wanted to.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"You don't sweat either, do you?  Like a dragon doesn't?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"No.  No sweat glands, whole body.  I'm immune to extreme hot and cold, so I wouldn't need any."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["'Sides, I wouldn't wanna stink and have to worry about wearing deodorant and stuff anyways.\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"You don't any hair on your crotch, either?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Nope, not a single one.  I think that stuff is ugly anyways.  I've also heard from humans that it itches and stuff."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Hey don't tell your mom and dad that you asked me that question, okay?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"I wanted to know!\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Well, now you know.  I can tell you haven't met too many draco people before, but just don't tell your mom and dad that you asked me that last one."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Glad I could make your day, though.  This was a real treat for you, getting to talk to a half dragon, wasn't it?\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":0,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":0,"parameters":["\"Yeah!\""]},{"code":111,"indent":0,"parameters":[0,4,0]},{"code":101,"indent":1,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":1,"parameters":["\"How did your head get bitten off?\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":1,"parameters":[22]},{"code":101,"indent":1,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":1,"parameters":["\"Well, I fight monsters and stuff out in the countryside, and it can be dangerous.  Sometimes they come at me with swords, claws, horns, fangs, and stuff."]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["Accidents happen.  Its okay though, I know how to re-attach it.\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":1,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":1,"parameters":["\"Does it hurt?  Does it bleed a lot when it gets cut off?\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":1,"parameters":[22]},{"code":101,"indent":1,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":1,"parameters":["\"No, for me it doesn't hurt at all, but I do feel it.  It isn't that bad.  Actually, its kinda fun - I like fighting."]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["As for bleeding, yeah, it bleeds and gushes for a few seconds, then it slows down and stops, and maybe drips a little, then that stops."]},{"code":401,"indent":1,"parameters":["Kinda feels good when it happens though, like I said.  I guess its my dragon side.\""]},{"code":357,"indent":1,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":101,"indent":1,"parameters":["girls 1",6,1,2,"Citizen"]},{"code":401,"indent":1,"parameters":["\"Wow.\""]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":1,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":20,"y":14},
