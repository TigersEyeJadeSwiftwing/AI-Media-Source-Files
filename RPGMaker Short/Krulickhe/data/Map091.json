{"id":5,"name":"Benny","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"AsianMale1","direction":4,"pattern":1,"characterIndex":7},"list":[{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Strange Man"]},{"code":401,"indent":0,"parameters":["You see a man who looks oddly familiar."]},{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Strange Man"]},{"code":401,"indent":0,"parameters":["\"This world is threatened by a supervolcano that has been sleeping for millions of years, but is just starting to wake up and show signs of activity."]},{"code":401,"indent":0,"parameters":["Zarakite dragons haven't established protected shelters or cities that can survive a catastrophic eruption, not in this world.  Saving the people,"]},{"code":401,"indent":0,"parameters":["and all life actually, of this world, hinges upon someone or someones to find a way to stop the supervolcano from erupting, or in some other way"]},{"code":401,"indent":0,"parameters":["rescue all the people, animals, and other life from it.\""]},{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Strange Man"]},{"code":401,"indent":0,"parameters":["\"An outsider, a strange teenage girl came around to this town, who got caught up in things much like her older brother,"]},{"code":401,"indent":0,"parameters":["some 22 year old half dragon guy.  She seemed a bit lost, and didn't appear to be anyone with a solution to the supervolcano."]},{"code":401,"indent":0,"parameters":["She simply wanted to return home somehow...  Interesting...\""]},{"code":101,"indent":0,"parameters":["AsianMale1",7,1,2,"Strange Man"]},{"code":401,"indent":0,"parameters":["\"While there are a few zarakite dragon families in this world, there aren't enough to build shelters for everyone in time, not in these lands."]},{"code":401,"indent":0,"parameters":["I'd say good luck to any brave few who would venture out and try to save this world..."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Now if you'll excuse me, I'm done eating, and need to get going...\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Dude, haven't we seen you before?  You look familiar.  I remember-\""]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Hide BattleBG","Hide BattleBG",{}]},{"code":205,"indent":0,"parameters":[0,{"list":[{"code":42,"parameters":[0],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":42,"parameters":[0],"indent":null}]},{"code":101,"indent":0,"parameters":["",7,1,2,"Strange Man"]},{"code":401,"indent":0,"parameters":["The man suddenly isn't there anymore."]},{"code":357,"indent":0,"parameters":["TJS_AltMenus","Show BattleBG","Show BattleBG",{}]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Whoah!  Hey...\""]},{"code":117,"indent":0,"parameters":[23]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Aw man I hope that lost girl isn't my sister Alice!  She and Sekk were downstairs in the game room when we all got teleported to"]},{"code":401,"indent":0,"parameters":["Zinkland's first funhouse of a world!  Well, unless you count Camp Zinkland, that tiny sub-world right after classes ended.\""]},{"code":117,"indent":0,"parameters":[26]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[2]"]},{"code":401,"indent":0,"parameters":["\"I hope Alice is okay!  We should try to find her!\""]},{"code":357,"ind