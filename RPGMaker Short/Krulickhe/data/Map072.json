eters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["\"Yeah, I remember.  We go way back.  I should probably call him."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Geez, I just remembered I have a spare key to his house in my pocket.\""]},{"code":117,"indent":0,"parameters":[26]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[2]"]},{"code":401,"indent":0,"parameters":["\"Well, make up your mind what to do with it.  It's up to you.\""]},{"code":117,"indent":0,"parameters":[31]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[4]"]},{"code":401,"indent":0,"parameters":["\"I kinda like him in a few ways, but his latest prank, geez...  I'll stand with you whether you keep him as a friend or not,"]},{"code":401,"indent":0,"parameters":["\\P[1], it's your call.\""]},{"code":117,"indent":0,"parameters":[28]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[3]"]},{"code":401,"indent":0,"parameters":["\"Yeah, your call.\""]},{"code":117,"indent":0,"parameters":[52]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[6]"]},{"code":401,"indent":0,"parameters":["\"I feel the same way.  Your call.\""]},{"code":117,"indent":0,"parameters":[49]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[5]"]},{"code":401,"indent":0,"parameters":["\\P[5] holds up his hand to speak."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Ditto.  Up to you.\""]},{"code":117,"indent":0,"parameters":[22]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":0,"parameters":["You hold up the key to the sun and air, staring at it for a moment."]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["\"Um...\""]},{"code":102,"indent":0,"parameters":[["Keep Benny's key.","Throw it away!"],-1,-1,1,1]},{"code":402,"indent":0,"parameters":[0,"Keep Benny's key."]},{"code":101,"indent":1,"parameters":["",0,1,2,"\\P[1]"]},{"code":401,"indent":1,"parameters":["\"Ah, wh